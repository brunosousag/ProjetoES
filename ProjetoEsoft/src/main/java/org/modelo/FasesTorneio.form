<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.modelo.FasesTorneio">
  <grid id="root" binding="janelaBracket" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
